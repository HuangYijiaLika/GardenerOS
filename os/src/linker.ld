/* 
 * 链接脚本（Linker Script）
 * 
 * 这个文件告诉链接器如何将编译后的代码和数据组织到内存中
 * 就像规划一栋大楼的布局：哪里放代码，哪里放数据，哪里放栈
 */

/* 指定输出架构为 RISC-V */
OUTPUT_ARCH(riscv)

/* 指定程序的入口点为 _start（在 entry.asm 中定义） */
ENTRY(_start)

/* 内核加载的基地址（物理地址） */
/* QEMU 会把内核加载到这个地址 */
BASE_ADDRESS = 0x80200000;

/* SECTIONS 块定义了内存布局 */
SECTIONS
{
    /* 将当前地址设置为基地址 */
    . = BASE_ADDRESS;
    skernel = .;  /* 记录内核起始地址 */

    /* ========== .text 段（代码段）========== */
    /* 存放程序的可执行代码 */
    stext = .;    /* 代码段起始标记 */
    .text : {
        *(.text.entry)   /* 先放入口代码（entry.asm 中的 _start） */
        . = ALIGN(4K);
        strampoline = .;
        *(.text.trampoline);
        . = ALIGN(4K);
        *(.text .text.*) /* 再放其他代码 */
    }

    /* 按 4KB 对齐（内存页大小） */
    . = ALIGN(4K);
    etext = .;    /* 代码段结束标记 */

    /* ========== .rodata 段（只读数据段）========== */
    /* 存放只读数据，比如字符串常量 */
    srodata = .;  /* 只读数据段起始标记 */
    .rodata : {
        *(.rodata .rodata.*)   /* 只读数据 */
        *(.srodata .srodata.*) /* 小只读数据 */
    }

    . = ALIGN(4K);
    erodata = .;  /* 只读数据段结束标记 */

    /* ========== .data 段（已初始化数据段）========== */
    /* 存放已经初始化的全局变量 */
    sdata = .;    /* 已初始化数据段起始标记 */
    .data : {
        *(.data .data.*)     /* 已初始化数据 */
        *(.sdata .sdata.*)   /* 小已初始化数据 */
    }

    . = ALIGN(4K);
    edata = .;    /* 已初始化数据段结束标记 */

    /* ========== .bss 段（未初始化数据段）========== */
    /* 存放未初始化的全局变量，启动时会被清零 */
    sbss_with_stack = .;
    .bss : {
        *(.bss.stack)  /* 先放栈空间（在 entry.asm 中定义） */
        sbss = .;      /* .bss 段起始标记 */
        *(.bss .bss.*)     /* 未初始化数据 */
        *(.sbss .sbss.*)   /* 小未初始化数据 */
    }

    . = ALIGN(4K);
    ebss = .;     /* .bss 段结束标记 */
    ekernel = .;  /* 内核结束标记 */

    /* ========== 丢弃不需要的段 ========== */
    /DISCARD/ : {
        *(.eh_frame)  /* 异常处理帧，裸机环境不需要 */
    }
}

/* 内存布局总结：
 * 
 * 地址从低到高排列：
 * ┌─────────────────────────────────────────────────────┐
 * │  0x80200000                                        │
 * │  ┌──────────┐  ← stext/skernel                    │
 * │  │  .text   │  代码段：存放程序指令                  │
 * │  └──────────┘  ← etext                            │
 * │  ┌──────────┐  ← srodata                          │
 * │  │ .rodata  │  只读数据段：字符串常量等              │
 * │  └──────────┘  ← erodata                          │
 * │  ┌──────────┐  ← sdata                            │
 * │  │  .data   │  已初始化数据段：全局变量（有初始值）   │
 * │  └──────────┘  ← edata                            │
 * │  ┌──────────┐  ← boot_stack                       │
 * │  │   stack  │  栈空间：程序运行时临时数据            │
 * │  └──────────┘  ← boot_stack_top / sbss            │
 * │  ┌──────────┐                                     │
 * │  │   .bss   │  未初始化数据段：全局变量（无初始值）   │
 * │  └──────────┘  ← ebss/ekernel                     │
 * └─────────────────────────────────────────────────────┘
 */